+// Is the LED render slot one of ours (101..115)?
+static inline bool _slotIsOurs(uint8_t hp) {
+  byte f = LED_command[hp].LEDFunction;
+  return f >= 101 && f <= (byte)(FLTHY_FX_BASE + (uint8_t)CE_TWINKLE);
